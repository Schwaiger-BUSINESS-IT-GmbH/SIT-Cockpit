# ---------- Demo ----------
# DEMO=1 startet mit Beispieldaten (Atera + weclapp simuliert), Login-Token: demo-rene
# Einfacher: npm run demo
# DEMO=1

# ---------- weclapp ----------
# Mandant, z.B. "schwaiger" für https://schwaiger.weclapp.com
WECLAPP_TENANT=deinmandant
# Optional: API-URL komplett überschreiben
# WECLAPP_BASE_URL=https://deinmandant.weclapp.com/webapp/api/v2

# ---------- Atera ----------
# API-Schlüssel: Atera > Admin > API. Bleibt am Server, geht nie an den Browser.
ATERA_API_KEY=
# Wie oft die Kundenübersicht im Hintergrund aktualisiert wird (Sekunden)
# ATERA_REFRESH_SECONDS=180
# Name des Atera-Kundenfelds mit der weclapp-Kundennummer (Zuordnung Atera <-> weclapp)
# ATERA_CUSTOMER_NUMBER_FIELD=weclapp-Kundennummer
# Übersicht zeigt nur Server und Firewalls.
# Server ab X Min. offline = kritisch; ab X Tagen offline = veraltet (kein Alarm, Aufräum-Hinweis)
# SERVER_OFFLINE_MINUTES=15
# STALE_SERVER_DAYS=30

# ---------- Angebotsboard ----------
# Produkte, Preise, SLA-Modell und Texte: config/angebotsboard.json
# (jede sku dort braucht einen weclapp-Artikel mit gleicher Artikelnummer)
# Nach Unterschrift Angebot annehmen UND Auftrag erzeugen (0 = nur Angebot auf "angenommen")
# OFFER_CREATE_SALES_ORDER=1
# OFFER_VALID_DAYS=30
# TERMS_URL=https://www.schwaiger-it.at/agb
# VAT_PERCENT=20

# ---------- Tickets aus Atera-Problemen ----------
# Optional feste Vorbelegung (sonst automatisch über die Namen in weclapp)
# TICKET_STATUS_ID=
# TICKET_CHANNEL_ID=
# TICKET_PRIORITY_CRITICAL_ID=
# TICKET_PRIORITY_WARNING_ID=

# ---------- Verträge (Managed-Service-Umsatz) ----------
# Optional: API-Token eines weclapp-Benutzers MIT Vertragslizenz. Wird nur zum Lesen
# der aktiven Verträge genutzt; an den Browser gehen nur Summen. Ohne Token gelten die
# Rechte des angemeldeten Benutzers.
# WECLAPP_CONTRACTS_TOKEN=

# ---------- Finanzen (nur Geschäftsführung/Buchhaltung) ----------
# Objekt-ID der Entra-Gruppe "SIT-Cockpit Finanzen" (setzt infra/7-setup-finance-access.ps1 in Azure)
# FINANCE_GROUP_ID=
# Nur lokale Entwicklung ohne Microsoft-Login: Finanzen trotzdem anzeigen
# FINANCE_LOCAL=1

# ---------- Dashboard ----------
# Angebote ab X Tagen als "nachfassen" markieren
# QUOTATION_FOLLOWUP_DAYS=14

# ---------- Allgemein ----------
# Zufälliger langer String (mind. 32 Zeichen) – verschlüsselt Sessions und gespeicherte Tokens
SESSION_SECRET=bitte-aendern-mindestens-32-zeichen-lang-xxxxxxxx
PORT=3000
# Hinter HTTPS: 1
# COOKIE_SECURE=1
# Nur mit Microsoft-Login (Azure Easy Auth) erreichbar
# REQUIRE_ENTRA=1

# ---------- Zeiten (SIT-Time) ----------
# ROUND_MINUTES=15
# ARTICLE_TYPE=SERVICE
# ARTICLE_NUMBERS=DL-REMOTE,DL-VORORT
# TICKET_HIDDEN_STATUS_IDS=
# WECLAPP_ATTENDANCE=1
